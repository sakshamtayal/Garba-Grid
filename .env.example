# GarbaGrid Environment Variables
# Copy this file to .env.local and fill in real values

# ─── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here-minimum-32-chars

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/garba-grid?retryWrites=true&w=majority

# ─── Cloudinary (Free tier: 25GB storage, 25GB bandwidth/month) ───────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=garba-grid-profiles

# ─── Pusher (Free: 100 connections, 200k messages/day) ────────────────────────
PUSHER_APP_ID=your-pusher-app-id
NEXT_PUBLIC_PUSHER_APP_KEY=your-pusher-key
PUSHER_APP_SECRET=your-pusher-secret
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=saksham_tayal
ADMIN_SECRET_KEY=your-admin-secret-key
